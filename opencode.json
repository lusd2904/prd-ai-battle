{
  "$schema": "https://opencode.ai/config.json",
  "model": "prd-xixi/claude-opus-5",
  "default_agent": "primary",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "provider": {
    "prd-xixi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "xixiapi.io",
      "env": ["PRD_SFP_XIXI_KEY"],
      "options": {
        "baseURL": "https://xixiapi.io/v1",
        "apiKey": "{env:PRD_SFP_XIXI_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5 (primary)"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5 (advisor)"
        }
      }
    },
    "prd-openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "env": ["PRD_SFP_OPENROUTER_KEY"],
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:PRD_SFP_OPENROUTER_KEY}"
      },
      "models": {
        "z-ai/glm-5.2:free": {
          "name": "GLM 5.2 (OpenRouter :free, seed advisor)"
        },
        "meta/muse-spark-1.2": {
          "name": "Muse Spark 1.2 (OpenRouter, paid)"
        },
        "x-ai/grok-4.6": {
          "name": "Grok 4.6 (OpenRouter, optional — not seed)"
        }
      }
    },
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen (official provider id: opencode)",
      "env": ["PRD_OPENCODE_ZEN_KEY", "OPENCODE_API_KEY"],
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:PRD_OPENCODE_ZEN_KEY}"
      },
      "models": {
        "mimo-v2.5-free": { "name": "MiMo V2.5 Free (OpenCode Zen)" },
        "ling-3.0-flash-fin-free": { "name": "Ling 3.0 Flash Fin Free (OpenCode Zen)" },
        "nemotron-3.5-lightning-free": { "name": "Nemotron 3.5 Lightning Free (OpenCode Zen)" },
        "nemotron-3-ultra-free": { "name": "Nemotron 3 Ultra Free (OpenCode Zen)" },
        "big-pickle": { "name": "Big Pickle (OpenCode Zen)" }
      }
    },
    "prd-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local backup gateway",
      "env": ["PRD_AI_GATEWAY_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:PRD_AI_GATEWAY_KEY}"
      },
      "models": {
        "grok-4.5": { "name": "Backup Grok 4.5" },
        "grok-composer-2.5-fast": { "name": "Backup Grok Composer 2.5 Fast" }
      }
    },
    "prd-codex": {
      "npm": "@ai-sdk/openai",
      "name": "Codex / ChatGPT (optional Mac)",
      "env": ["PRD_CODEX_KEY", "OPENAI_API_KEY"],
      "options": {
        "apiKey": "{env:PRD_CODEX_KEY}"
      },
      "models": {
        "gpt-5-codex": { "name": "GPT-5 Codex (optional)" },
        "gpt-5.1-codex": { "name": "GPT-5.1 Codex (optional)" }
      }
    },
    "prd-claude-code": {
      "npm": "@ai-sdk/anthropic",
      "name": "Claude Code CLI (optional Mac)",
      "env": ["PRD_CLAUDE_CODE_KEY", "ANTHROPIC_API_KEY"],
      "options": {
        "apiKey": "{env:PRD_CLAUDE_CODE_KEY}"
      },
      "models": {
        "claude-opus-5": { "name": "Claude Opus 5 via Claude Code (optional)" },
        "claude-sonnet-5": { "name": "Claude Sonnet 5 via Claude Code (optional)" }
      }
    },
    "prd-antigravity": {
      "npm": "@ai-sdk/google",
      "name": "Antigravity / 反重力 (optional Mac)",
      "env": ["PRD_ANTIGRAVITY_KEY", "PRD_GEMINI_KEY", "GEMINI_API_KEY"],
      "options": {
        "apiKey": "{env:PRD_ANTIGRAVITY_KEY}"
      },
      "models": {
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash via Antigravity (optional)" },
        "gemini-2.5-pro": { "name": "Gemini 2.5 Pro via Antigravity (optional)" }
      }
    },
    "prd-gemini": {
      "npm": "@ai-sdk/google",
      "name": "Gemini CLI (optional Mac fallback)",
      "env": ["PRD_GEMINI_KEY", "GEMINI_API_KEY"],
      "options": {
        "apiKey": "{env:PRD_GEMINI_KEY}"
      },
      "models": {
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash (optional)" },
        "gemini-2.5-pro": { "name": "Gemini 2.5 Pro (optional)" }
      }
    },
    "prd-xai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "xAI Grok HTTP (optional)",
      "env": ["PRD_XAI_KEY", "XAI_API_KEY"],
      "options": {
        "baseURL": "https://api.x.ai/v1",
        "apiKey": "{env:PRD_XAI_KEY}"
      },
      "models": {
        "grok-4": { "name": "Grok 4 (optional xAI)" },
        "grok-4.5": { "name": "Grok 4.5 (optional xAI)" }
      }
    }
  },
  "providers": {
    "prd-xixi": {
      "name": "xixiapi.io",
      "env": ["PRD_SFP_XIXI_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://xixiapi.io/v1",
        "apiKey": "{env:PRD_SFP_XIXI_KEY}"
      },
      "models": {
        "claude-opus-5": { "name": "Claude Opus 5 (primary)" },
        "claude-sonnet-5": { "name": "Claude Sonnet 5 (advisor)" }
      }
    },
    "prd-openrouter": {
      "name": "OpenRouter",
      "env": ["PRD_SFP_OPENROUTER_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:PRD_SFP_OPENROUTER_KEY}"
      },
      "models": {
        "z-ai/glm-5.2:free": { "name": "GLM 5.2 (OpenRouter :free, seed advisor)" },
        "meta/muse-spark-1.2": { "name": "Muse Spark 1.2 (OpenRouter, paid)" },
        "x-ai/grok-4.6": { "name": "Grok 4.6 (OpenRouter, optional — not seed)" }
      }
    },
    "opencode": {
      "name": "OpenCode Zen (official provider id: opencode)",
      "env": ["PRD_OPENCODE_ZEN_KEY", "OPENCODE_API_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:PRD_OPENCODE_ZEN_KEY}"
      },
      "models": {
        "mimo-v2.5-free": { "name": "MiMo V2.5 Free (OpenCode Zen)" },
        "ling-3.0-flash-fin-free": { "name": "Ling 3.0 Flash Fin Free (OpenCode Zen)" },
        "nemotron-3.5-lightning-free": { "name": "Nemotron 3.5 Lightning Free (OpenCode Zen)" },
        "nemotron-3-ultra-free": { "name": "Nemotron 3 Ultra Free (OpenCode Zen)" },
        "big-pickle": { "name": "Big Pickle (OpenCode Zen)" }
      }
    },
    "prd-gateway": {
      "name": "Local backup gateway",
      "env": ["PRD_AI_GATEWAY_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:PRD_AI_GATEWAY_KEY}"
      },
      "models": {
        "grok-4.5": { "name": "Backup Grok 4.5" },
        "grok-composer-2.5-fast": { "name": "Backup Grok Composer 2.5 Fast" }
      }
    },
    "prd-codex": {
      "name": "Codex / ChatGPT (optional Mac)",
      "env": ["PRD_CODEX_KEY", "OPENAI_API_KEY"],
      "package": "@opencode-ai/ai/providers/openai",
      "settings": {
        "apiKey": "{env:PRD_CODEX_KEY}"
      },
      "models": {
        "gpt-5-codex": { "name": "GPT-5 Codex (optional)" },
        "gpt-5.1-codex": { "name": "GPT-5.1 Codex (optional)" }
      }
    },
    "prd-claude-code": {
      "name": "Claude Code CLI (optional Mac)",
      "env": ["PRD_CLAUDE_CODE_KEY", "ANTHROPIC_API_KEY"],
      "package": "@opencode-ai/ai/providers/anthropic",
      "settings": {
        "apiKey": "{env:PRD_CLAUDE_CODE_KEY}"
      },
      "models": {
        "claude-opus-5": { "name": "Claude Opus 5 via Claude Code (optional)" },
        "claude-sonnet-5": { "name": "Claude Sonnet 5 via Claude Code (optional)" }
      }
    },
    "prd-antigravity": {
      "name": "Antigravity / 反重力 (optional Mac)",
      "env": ["PRD_ANTIGRAVITY_KEY", "PRD_GEMINI_KEY", "GEMINI_API_KEY"],
      "package": "@opencode-ai/ai/providers/google",
      "settings": {
        "apiKey": "{env:PRD_ANTIGRAVITY_KEY}"
      },
      "models": {
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash via Antigravity (optional)" },
        "gemini-2.5-pro": { "name": "Gemini 2.5 Pro via Antigravity (optional)" }
      }
    },
    "prd-gemini": {
      "name": "Gemini CLI (optional Mac fallback)",
      "env": ["PRD_GEMINI_KEY", "GEMINI_API_KEY"],
      "package": "@opencode-ai/ai/providers/google",
      "settings": {
        "apiKey": "{env:PRD_GEMINI_KEY}"
      },
      "models": {
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash (optional)" },
        "gemini-2.5-pro": { "name": "Gemini 2.5 Pro (optional)" }
      }
    },
    "prd-xai": {
      "name": "xAI Grok HTTP (optional)",
      "env": ["PRD_XAI_KEY", "XAI_API_KEY"],
      "package": "@opencode-ai/ai/providers/xai",
      "settings": {
        "baseURL": "https://api.x.ai/v1",
        "apiKey": "{env:PRD_XAI_KEY}"
      },
      "models": {
        "grok-4": { "name": "Grok 4 (optional xAI)" },
        "grok-4.5": { "name": "Grok 4.5 (optional xAI)" }
      }
    }
  },
  "agent": {
    "primary": {
      "description": "Lead drafter. Writes files only in execute/revise (enforced by write_lock).",
      "mode": "primary",
      "model": "prd-xixi/claude-opus-5",
      "prompt": "{file:./.opencode/prompts/primary.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "advisor-sonnet": {
      "description": "Advisor (Claude Sonnet 5). Discuss and review only. Never edits files.",
      "mode": "all",
      "model": "prd-xixi/claude-sonnet-5",
      "prompt": "{file:./.opencode/prompts/advisor.txt}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "advisor-glm": {
      "description": "Advisor (GLM 5.2 OpenRouter :free). Discuss and review only. Never edits files.",
      "mode": "all",
      "model": "prd-openrouter/z-ai/glm-5.2:free",
      "prompt": "{file:./.opencode/prompts/advisor.txt}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "build": {
      "mode": "primary",
      "model": "prd-xixi/claude-opus-5",
      "permission": {
        "edit": "ask"
      }
    }
  },
  "agents": {
    "primary": {
      "description": "Lead drafter. Writes files only in execute/revise (enforced by write_lock).",
      "mode": "primary",
      "model": "prd-xixi/claude-opus-5",
      "system": "You are the primary / lead of prd-ai-battle. See AGENTS.md.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "advisor-sonnet": {
      "description": "Advisor (Claude Sonnet 5). Discuss and review only. Never edits files.",
      "mode": "all",
      "model": "prd-xixi/claude-sonnet-5",
      "system": "You are advisor-sonnet. You never edit files or run shell. See AGENTS.md.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "advisor-glm": {
      "description": "Advisor (GLM 5.2 OpenRouter :free). Discuss and review only. Never edits files.",
      "mode": "all",
      "model": "prd-openrouter/z-ai/glm-5.2:free",
      "system": "You are advisor-glm. You never edit files or run shell. See AGENTS.md.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "permission": {
    "edit": "ask"
  },
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" }
  ],
  "command": {
    "discuss": {
      "description": "Parallel multi-model discussion (tools=[], no writes)",
      "agent": "primary",
      "template": "Run the discuss phase. See AGENTS.md."
    },
    "lock": {
      "description": "Lock the 响应对照表 → phase=locked",
      "agent": "primary"
    },
    "execute": {
      "description": "Primary writes v1 (write_lock opens for primary only)",
      "agent": "primary"
    },
    "review": {
      "description": "Advisors review brief + matrix + chapter_diff only",
      "agent": "primary"
    },
    "revise": {
      "description": "Primary writes the next artifact_version",
      "agent": "primary"
    }
  },
  "commands": {
    "discuss": {
      "description": "Parallel multi-model discussion (tools=[], no writes)",
      "agent": "primary",
      "template": "Run the discuss phase. See AGENTS.md."
    },
    "lock": {
      "description": "Lock the 响应对照表 → phase=locked",
      "agent": "primary",
      "template": "Lock the compliance matrix. See AGENTS.md."
    },
    "execute": {
      "description": "Primary writes v1 (write_lock opens for primary only)",
      "agent": "primary",
      "template": "Enter execute. Only primary may write. See AGENTS.md."
    },
    "review": {
      "description": "Advisors review brief + matrix + chapter_diff only",
      "agent": "primary",
      "template": "Enter review with brief+matrix+chapter_diff only. See AGENTS.md."
    },
    "revise": {
      "description": "Primary writes the next artifact_version",
      "agent": "primary",
      "template": "Enter revise. Only primary may write. See AGENTS.md."
    }
  }
}
