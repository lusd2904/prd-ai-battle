# Copy to gitignored prd-ai-battle.env and fill in values:
#   cp prd-ai-battle.env.example prd-ai-battle.env
#
# Launch (`prd-ai-battle` / first `init`) loads prd-ai-battle.env into the
# process environment when a variable is unset. Never commit real secrets.
# This file is KEY NAMES only — empty values.

# xixiapi.io — seed primary (claude-opus-5) and advisor-sonnet (claude-sonnet-5)
PRD_SFP_XIXI_KEY=

# OpenRouter — seed advisor-grok (x-ai/grok-4.6)
PRD_SFP_OPENROUTER_KEY=

# Optional local grok2api backup (default http://127.0.0.1:8000/v1).
# Speaks grok-4.5 / grok-composer-2.5-fast — NOT Claude.
# 429 quota means reachable, credits empty; keep optional, not "healthy".
PRD_AI_GATEWAY_KEY=

# Optional override of the backup gateway URL (uncomment to set).
# PRD_AI_GATEWAY_URL=

# Optional Mac speakers (not on the seed team). HTTP and/or local CLI.
# Copy this file to gitignored prd-ai-battle.env and fill only what you use.
# Missing keys/CLIs: doctor/ping report missing — init does not crash.

# Codex CLI (`codex`) or OpenCode openai provider. Or: opencode auth / codex login.
PRD_CODEX_KEY=
OPENAI_API_KEY=

# Claude Code CLI (`claude -p`) — distinct from seed xixi HTTP Claude.
PRD_CLAUDE_CODE_KEY=
ANTHROPIC_API_KEY=

# Antigravity / 反重力 (`agy`, then `antigravity`) with Gemini CLI (`gemini`) fallback.
PRD_ANTIGRAVITY_KEY=
PRD_GEMINI_KEY=
GEMINI_API_KEY=

# Optional official xAI HTTP (https://api.x.ai/v1). Do not duplicate OpenRouter.
# Local Grok tool path remains grok2api at :8000 (PRD_AI_GATEWAY_KEY) or `grok` CLI.
PRD_XAI_KEY=
XAI_API_KEY=
