# Copy to gitignored prd-ai-battle.env and fill in values:
#   cp prd-ai-battle.env.example prd-ai-battle.env
#
# Launch (`prd-ai-battle` / first `init`) loads prd-ai-battle.env into the
# process environment when a variable is unset. Never commit real secrets.
# This file is KEY NAMES only — empty values.

# xixiapi.io — seed primary (claude-opus-5) and advisor-sonnet (claude-sonnet-5)
PRD_SFP_XIXI_KEY=

# OpenRouter — seed advisor-grok (x-ai/grok-4.6)
PRD_SFP_OPENROUTER_KEY=

# Optional local grok2api backup (default http://127.0.0.1:8000/v1).
# Speaks grok-4.5 / grok-composer-2.5-fast — NOT Claude.
# 429 quota means reachable, credits empty; keep optional, not "healthy".
PRD_AI_GATEWAY_KEY=

# Optional override of the backup gateway URL (uncomment to set).
# PRD_AI_GATEWAY_URL=
