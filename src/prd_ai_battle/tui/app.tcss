Screen {
    background: #0e1116;
    color: #e6edf3;
}

Header {
    background: #161b22;
    color: #79c0ff;
    text-style: bold;
}

Footer {
    background: #161b22;
}

#body {
    height: 1fr;
}

#projects {
    width: 18;
    min-width: 14;
    border: tall #30363d;
    margin: 0 0 0 1;
    background: #0e1116;
}

#projects-title {
    height: 1;
    text-style: bold;
    color: #79c0ff;
    padding: 0 1;
}

#project-list {
    height: 1fr;
    padding: 0 0 0 0;
}

#projects .project-item {
    width: 100%;
    min-height: 1;
    margin: 0 0 1 0;
    border: tall #30363d;
    background: #161b22;
    color: #c9d1d9;
}

#projects .project-item.active {
    background: #1f4e79;
    color: #58a6ff;
    text-style: bold;
    border: tall #58a6ff;
}

#new-project {
    margin: 0 1 0 1;
    border: tall #30363d;
}

#new-project-name {
    height: 3;
    margin: 0 1 1 1;
}

#left {
    width: 36%;
    min-width: 28;
    border: tall #30363d;
    margin: 0 0 0 1;
}

#right {
    width: 1fr;
    border: tall #30363d;
    margin: 0 1 0 0;
}

#status {
    dock: top;
    height: 1;
    background: #21262d;
    color: #c9d1d9;
    padding: 0 1;
}

#state {
    padding: 1;
}

TabbedContent {
    height: 1fr;
}

#requirement, #brief {
    padding: 1;
}

#chat-banner {
    height: 1;
    color: #8b949e;
    padding: 0 1;
}

#chat {
    height: 1fr;
    padding: 0 1 1 1;
}

.bubble {
    height: auto;
    margin: 1 1 0 0;
    padding: 0 1 1 1;
    background: #161b22;
    border: round #30363d;
}

.bubble-header {
    text-style: bold;
    color: #8b949e;
    height: 1;
}

.bubble-body {
    height: auto;
    color: #e6edf3;
}

.speaker-user {
    border: round #238636;
    border-left: heavy #3fb950;
}

.speaker-user .bubble-header {
    color: #3fb950;
}

.speaker-primary {
    border: round #1f4e79;
    border-left: heavy #58a6ff;
}

.speaker-primary .bubble-header {
    color: #58a6ff;
}

.speaker-0 {
    border: round #5a3d7a;
    border-left: heavy #d2a8ff;
}

.speaker-0 .bubble-header {
    color: #d2a8ff;
}

.speaker-1 {
    border: round #6b5a1e;
    border-left: heavy #f2cc60;
}

.speaker-1 .bubble-header {
    color: #f2cc60;
}

.speaker-2 {
    border: round #6e2f2c;
    border-left: heavy #ff7b72;
}

.speaker-2 .bubble-header {
    color: #ff7b72;
}

.speaker-3 {
    border: round #16565a;
    border-left: heavy #39d0d6;
}

.speaker-3 .bubble-header {
    color: #39d0d6;
}

.speaker-4 {
    border: round #6b3a58;
    border-left: heavy #ff9bce;
}

.speaker-4 .bubble-header {
    color: #ff9bce;
}

.speaker-5 {
    border: round #2d5a32;
    border-left: heavy #7ee787;
}

.speaker-5 .bubble-header {
    color: #7ee787;
}

.speaker-6 {
    border: round #6b4a24;
    border-left: heavy #ffa657;
}

.speaker-6 .bubble-header {
    color: #ffa657;
}

.speaker-7 {
    border: round #2a4d6e;
    border-left: heavy #a5d6ff;
}

.speaker-7 .bubble-header {
    color: #a5d6ff;
}

#composer {
    dock: bottom;
    height: 3;
    margin: 0 1 0 1;
}

DataTable {
    height: 1fr;
}
